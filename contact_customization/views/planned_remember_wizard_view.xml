<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <data>

    <record id="view_planned_remember_wizard_form" model="ir.ui.view">
      <field name="name">res.partner.planned.remember.wizard.form</field>
      <field name="model">res.partner.planned.remember.wizard</field>
      <field name="arch" type="xml">
        <form string="Planned Remember">
          <group>
            <field name="partner_id" invisible="1"/>
            <field name="employee_id" readonly="1"/>
            <field name="planned_date" required="1"/>
          </group>
          <footer>
            <button name="action_confirm" string="Save" type="object" class="btn-primary"/>
            <button string="Cancel" class="btn-secondary" special="cancel"/>
          </footer>
        </form>
      </field>
    </record>

  </data>
</odoo>
