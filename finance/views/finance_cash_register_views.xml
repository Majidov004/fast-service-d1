<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_cash_register_list" model="ir.ui.view">
        <field name="name">finance.cash.register.list</field>
        <field name="model">finance.cash.register</field>
        <field name="arch" type="xml">
            <list string="Cash Registers">
                <field name="name"/>
                <field name="currency_id"/>
                <field name="responsible_user_id"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="view_finance_cash_register_form" model="ir.ui.view">
        <field name="name">finance.cash.register.form</field>
        <field name="model">finance.cash.register</field>
        <field name="arch" type="xml">
            <form string="Cash Register">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger"
                            invisible="active"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Main Cash"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="currency_id" options="{'no_create': True}"/>
                            <field name="responsible_user_id"/>
                        </group>
                        <group>
                            <field name="balance"/>
                            <field name="active" invisible="1"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1" placeholder="Optional note…"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_cash_register" model="ir.actions.act_window">
        <field name="name">Cash Registers</field>
        <field name="res_model">finance.cash.register</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
