<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Simplified currency list — one editable Rate field -->
    <record id="view_finance_currency_list" model="ir.ui.view">
        <field name="name">finance.res.currency.list</field>
        <field name="model">res.currency</field>
        <field name="arch" type="xml">
            <list string="Currencies" editable="bottom">
                <field name="is_company_currency" column_invisible="1"/>
                <field name="name" string="Currency"/>
                <field name="full_name" string="Name" optional="show"/>
                <field name="symbol"/>
                <field name="rate_hint" string=" "/>
                <field name="finance_rate" string="Rate" readonly="is_company_currency"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Simplified currency form — only the essentials -->
    <record id="view_finance_currency_form" model="ir.ui.view">
        <field name="name">finance.res.currency.form</field>
        <field name="model">res.currency</field>
        <field name="arch" type="xml">
            <form string="Currency">
                <sheet>
                    <field name="is_company_currency" invisible="1"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. USD"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="full_name" string="Name"/>
                            <field name="symbol"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <label for="finance_rate" string="Rate"/>
                            <div class="o_row">
                                <field name="rate_hint" readonly="1" nolabel="1"/>
                                <field name="finance_rate" nolabel="1"
                                       readonly="is_company_currency"/>
                            </div>
                            <div class="text-muted" colspan="2"
                                 invisible="is_company_currency">
                                Yalnız bu məzənnəni yaz — Odoo bu günkü tarixlə avtomatik qeyd edir.
                            </div>
                            <div class="text-muted" colspan="2"
                                 invisible="not is_company_currency">
                                Bu, şirkətin əsas valyutasıdır — məzənnə həmişə 1-dir.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_currency" model="ir.actions.act_window">
        <field name="name">Currencies</field>
        <field name="res_model">res.currency</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_finance_currency_list"/>
        <field name="context">{'active_test': False}</field>
    </record>

</odoo>
