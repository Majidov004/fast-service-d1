<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_expense_list" model="ir.ui.view">
        <field name="name">finance.expense.list</field>
        <field name="model">finance.expense</field>
        <field name="arch" type="xml">
            <list string="Expense Items" editable="bottom">
                <field name="name"/>
                <field name="note"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_finance_expense" model="ir.actions.act_window">
        <field name="name">Expense Items</field>
        <field name="res_model">finance.expense</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
