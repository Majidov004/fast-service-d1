    <menuitem id="menu_finance_config_categories"
              name="Categories"
              parent="menu_finance_config"
              action="action_finance_category"
              sequence="20"/>
    <menuitem id="menu_finance_config_expenses"
              name="Expense Items"
              parent="menu_finance_config"
              action="action_finance_expense"
              sequence="30"/>
    <menuitem id="menu_finance_config_payment_methods"
              name="Payment Methods"
              parent="menu_finance_config"
              action="action_finance_payment_method"
              sequence="40"/>

    <!-- Currencies — simplified rate management (single Rate field).
         Restricted to system admins (currency management is sensitive). -->
    <menuitem id="menu_finance_config_currencies"
              name="Currencies"
              parent="menu_finance_config"
              action="action_finance_currency"
              sequence="50"
              groups="base.group_system"/>

</odoo>
