<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_payment_method_list" model="ir.ui.view">
        <field name="name">finance.payment.method.list</field>
        <field name="model">finance.payment.method</field>
        <field name="arch" type="xml">
            <list string="Payment Methods" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_finance_payment_method" model="ir.actions.act_window">
        <field name="name">Payment Methods</field>
        <field name="res_model">finance.payment.method</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
