<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_finance_student_charge_list" model="ir.ui.view">
        <field name="name">finance.student.charge.list</field>
        <field name="model">finance.student.charge</field>
        <field name="arch" type="xml">
            <list string="Student Charges">
                <field name="name"/>
                <field name="date"/>
                <field name="student_id"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="source"/>
                <field name="trial_lesson_id"/>
            </list>
        </field>
    </record>

    <record id="view_finance_student_charge_form" model="ir.ui.view">
        <field name="name">finance.student.charge.form</field>
        <field name="model">finance.student.charge</field>
        <field name="arch" type="xml">
            <form string="Student Charge">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="student_id"/>
                            <field name="date"/>
                            <field name="source"/>
                        </group>
                        <group>
                            <field name="currency_id"/>
                            <field name="amount"/>
                            <field name="trial_lesson_id"/>
                        </group>
                    </group>
                    <group string="Note">
                        <field name="note" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_finance_student_charge" model="ir.actions.act_window">
        <field name="name">Student Charges</field>
        <field name="res_model">finance.student.charge</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
