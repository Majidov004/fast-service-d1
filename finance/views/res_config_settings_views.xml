<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_finance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.finance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Finance" string="Finance" name="finance">
                    <block title="Applicant Conversion" name="finance_conversion">
                        <setting string="Default Cash Register"
                                 help="Pre-selected when an applicant becomes a student.">
                            <field name="finance_default_register_id"/>
                        </setting>
                        <setting string="Student Payment Category"
                                 help="Income category used for the auto-created Cash In.">
                            <field name="finance_student_payment_category_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_finance_config_settings" model="ir.actions.act_window">
        <field name="name">Finance Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">inline</field>
        <field name="context">{'module': 'finance'}</field>
    </record>

</odoo>
