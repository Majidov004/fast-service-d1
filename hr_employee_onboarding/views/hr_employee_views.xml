<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_employee_form_onboarding" model="ir.ui.view">
        <field name="name">hr.employee.form.onboarding</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <header>

                    <!-- Onboarding tamamlanmayıbsa banner göstər -->
                    <div invisible="onboarding_done"
                         class="alert alert-warning mb-0 rounded-0 text-center"
                         style="font-size:15px; padding: 12px;">
                        <i class="fa fa-info-circle me-2"/>
                        Zəhmət olmasa bütün lazımi məlumatları doldurun və
                        <strong>Complete</strong> düyməsinə basın.
                    </div>

                    <button name="action_complete_onboarding"
                            string="Complete"
                            type="object"
                            class="btn-success"
                            icon="fa-check-circle"
                            invisible="onboarding_done"
                            confirm="Profil məlumatlarını tamamladınız? Complete etmək istəyirsiniz?"/>

                    <field name="onboarding_done" invisible="1"/>

                </header>
            </xpath>

        </field>
    </record>

</odoo>
