<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lesson_homework_wizard_form" model="ir.ui.view">
        <field name="name">lesson.homework.wizard.form</field>
        <field name="model">lesson.homework.wizard</field>
        <field name="arch" type="xml">
            <form string="Homework Files">
                <sheet>
                    <div class="oe_title">
                        <h2>
                            <field name="student_id" readonly="1"/>
                        </h2>
                        <h4>
                            <field name="lesson_id" readonly="1"/>
                        </h4>
                    </div>

                    <group>
                        <field name="attachment_ids"
                               widget="many2many_binary"
                               string="Homework Files"
                               nolabel="1"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_save"
                            string="Save &amp; Close"
                            type="object"
                            class="btn-primary"/>
                    <button string="Discard"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>