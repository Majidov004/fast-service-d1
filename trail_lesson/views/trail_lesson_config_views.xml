<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ══════════════════════════════════════════════════════════════════════
         COMPANY
    ══════════════════════════════════════════════════════════════════════════ -->
    <record id="view_trail_config_company_list" model="ir.ui.view">
        <field name="name">trail.lesson.config.company.list</field>
        <field name="model">trail.lesson.config.company</field>
        <field name="arch" type="xml">
            <list string="Companies" editable="bottom">
                <field name="name"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_trail_config_company_form" model="ir.ui.view">
        <field name="name">trail.lesson.config.company.form</field>
        <field name="model">trail.lesson.config.company</field>
        <field name="arch" type="xml">
            <form string="Company">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_trail_config_company" model="ir.actions.act_window">
        <field name="name">Companies</field>
        <field name="res_model">trail.lesson.config.company</field>
        <field name="view_mode">list,form</field>
    </record>

