<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Plan New Trial Lesson Wizard ──────────────────────────────────── -->
    <record id="view_trail_lesson_plan_wizard_form" model="ir.ui.view">
        <field name="name">trail.lesson.plan.wizard.form</field>
        <field name="model">trail.lesson.plan.wizard</field>
        <field name="arch" type="xml">
            <form string="Plan New Trial Lesson">
                <sheet>
                    <div class="oe_title mb-3">
                        <h4 class="text-muted">
                            <i class="fa fa-calendar-plus-o me-2"/>
                            Schedule a New Trial Lesson
                        </h4>
                    </div>
                    <group>
                        <field name="student_id"
                               options="{'no_create': True}"/>
                        <field name="teacher_id"
                               string="Trial Teacher"
                               options="{'no_create': True}"/>
                        <field name="lesson_datetime"
                               string="Trial DateTime"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Create &amp; Open"
                            class="btn-primary"
                            data-hotkey="v"/>
                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
