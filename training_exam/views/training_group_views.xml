<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Add Exam teacher + Program fields and the Exam tab to the Training Group form -->
    <record id="view_training_group_form_exam" model="ir.ui.view">
        <field name="name">training.group.form.exam</field>
        <field name="model">training.group</field>
        <field name="inherit_id" ref="training_management.view_training_group_form"/>
        <field name="arch" type="xml">
            <field name="teacher_id" position="after">
                <field name="exam_teacher_id"/>
                <field name="system_choice"/>
            </field>

            <xpath expr="//page[@name='meeting']" position="after">
                <page string="Exam" name="exam">
                    <field name="exam_view" widget="training_exam_widget" nolabel="1" readonly="1"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
